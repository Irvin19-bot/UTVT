# =====================================================
# Configuración del Bot de Scalping
# =====================================================
# Copia este archivo como .env y completa tus datos:
#   cp .env.example .env

# Credenciales de IQ Option
IQ_OPTION_EMAIL=tu_email@ejemplo.com
IQ_OPTION_PASSWORD=tu_contraseña

# Tipo de cuenta: PRACTICE (demo) o REAL
IQ_ACCOUNT_TYPE=PRACTICE

# Configuración de Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_bot_telegram
TELEGRAM_GROUP_ID=tu_id_de_grupo_telegram
